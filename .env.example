# Copy to .env for local Compose development. Do not use these values in production.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hotel_management
SESSION_SECRET=replace-with-a-local-secret-at-least-32-bytes-long
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8080
REDIS_PASSWORD=local-development-redis-password
REDIS_URL=redis://:local-development-redis-password@redis:6379